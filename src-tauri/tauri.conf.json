{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitbrix",
  "version": "0.1.1",
  "identifier": "dev.gitbrix.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "gitbrix",
        "width": 1400,
        "height": 880,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A graph-first Git client",
    "longDescription": "gitbrix is a desktop Git client with a commit graph, staging down to single lines, conflict resolution, interactive rebase and undo.",
    "publisher": "Selim Arda \u00c7evik",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "linux": {
      "rpm": {
        "release": "1"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwQkIxODFCODYyN0U3MEYKUldRUDV5ZUdHeGk3VUpSVGtKZ1hiRUhpa3J5aXV6a1JWY0l4aHpnNDc5MVMzQ1FaV2FsL3h2VlkK",
      "endpoints": [],
      "dangerousInsecureTransportProtocol": true
    }
  }
}
