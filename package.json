{
  "name": "gitbrix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "pnpm test:rust && pnpm test:unit && pnpm test:ui",
    "test:rust": "cd src-tauri && cargo test",
    "test:unit": "vitest run",
    "test:ui": "playwright test",
    "test:e2e": "tauri build --debug --no-bundle && node tests/e2e/run.mjs"
  },
  "dependencies": {
