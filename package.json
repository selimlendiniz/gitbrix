    "hast-util-to-jsx-runtime": "2.3.6",
    "highlight.js": "^11.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10.1.0",
    "rehype-parse": "9.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
